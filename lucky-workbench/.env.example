# OPC Trade Lab V1 - Environment Configuration Template
# Owner: Victor Chuyền · OPC AI REVENUE LAB
# All values are configuration examples; no real secrets.

APP_ENV=development
APP_MODE=paper
APP_DOMAIN=
PUBLIC_APP_ORIGIN=http://localhost:8080
DATABASE_URL=sqlite:////data/opc_trade.sqlite

# Auth configuration
AUTH_MODE=dev-local
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS_FILE=
OWNER_UID_ALLOWLIST=usr-victor-chuyen

# Backend URL for gateway or standalone frontend
BACKEND_BASE_URL=http://localhost:8000

# Safety Gates (Strictly false in V1)
LIVE_TRADING_ENABLED=false
BILLING_ENABLED=false
EXCHANGE_REFERRAL_ENABLED=false
BUILDER_ATTRIBUTION_ENABLED=false

# Market Data configuration
MARKET_DATA_MODE=synthetic
MAX_WATCHLIST_MARKETS=5
COLLECTOR_MAX_RECONNECT_SECONDS=60
LOG_LEVEL=INFO

# Optional AI Review (Disabled by default)
AI_REVIEW_ENABLED=false
GEMINI_API_KEY=
